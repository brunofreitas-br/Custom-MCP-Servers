# === Server ===
PORT=3000

# Cases beta is the primary incident backend by default.
# Set false to restore the original v1.0 incident behavior and response shapes.
# Microsoft does not support production use of Graph beta APIs.
CASE_MANAGEMENT_ENABLED=true

# === Auth Mode: Token Passthrough ===
# This MCP server holds ZERO credentials.
# The client (Copilot Studio) authenticates the user via OAuth 2.0
# and sends the user's Bearer token on every request.
# The server forwards that token directly to Microsoft Graph Security API.
#
# Benefits:
#   - No secrets to manage, rotate, or leak
#   - RBAC per user — each analyst only sees their permitted data
#   - The server is stateless and tenant-agnostic
#
# Required Delegated Permissions (on the Copilot Studio App Registration):
#   Microsoft Graph:
#     - CaseManagement.ReadWrite.All
#     - SecurityIncident.ReadWrite.All
#     - SecurityAlert.ReadWrite.All
#     - ThreatHunting.Read.All
#
# Read-only connections can use SecurityIncident.Read.All and
# SecurityAlert.Read.All instead, but cannot update or close resources.
# Updates also require Security Operator/Administrator or equivalent RBAC.
# Case reads can use CaseManagement.Read.All instead of ReadWrite.All.
# Case Management 401/403 errors are surfaced, not hidden by fallback.
